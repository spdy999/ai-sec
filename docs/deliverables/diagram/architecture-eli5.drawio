        <mxCell id="g1" value="WHERE PEOPLE ARE" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="240" height="570" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="THE ONLY WAY IN" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="310" y="110" width="210" height="570" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="OUR OWN PRIVATE AREA INSIDE AWS  ·  eu-central-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="110" width="920" height="570" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="WHERE OUR CODE RUNS  ·  no road out to the internet" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="580" y="175" width="400" height="475" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="WHERE THE STUFF IS KEPT  ·  locked with our own keys" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="175" width="330" height="475" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="SOMEONE IS ALWAYS WATCHING" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#E7157B;fillColor=#FCF0F6;verticalAlign=top;align=left;spacingLeft=30;fontColor=#E7157B;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1435" height="190" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="1 — The whole thing, in one picture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="A question travels left to right. It can only ever move forward through one door at a time, and the same guard checks it on the way out." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n_user" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;you ask a normal question&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;employee · browser or Teams&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="105" y="170" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_idp" value="&lt;b&gt;The company login&lt;/b&gt;&lt;br&gt;proves it is really you, and says which teams you are in&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;Entra ID · SSO + MFA + group claims&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1A73E8;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="65" y="350" width="190" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n_trust" value="&lt;b&gt;We trust the person.&lt;/b&gt;&lt;br&gt;We never trust their words. Everything they type is checked as if a stranger sent it." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;dashed=1;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="65" y="510" width="190" height="115" as="geometry" />
        </mxCell>

        <mxCell id="n_waf" value="&lt;b&gt;Bouncer on the street&lt;/b&gt;&lt;br&gt;throws out obvious junk and floods&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;AWS WAF&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1">
          <mxGeometry x="376" y="170" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_apigw" value="&lt;b&gt;The front desk&lt;/b&gt;&lt;br&gt;one entrance. Checks your badge is real and stops you asking too fast&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;API Gateway · OIDC validation + throttling&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1">
          <mxGeometry x="376" y="380" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="n_eks" value="&lt;b&gt;Our code lives here&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;Amazon EKS · private subnets&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="1">
          <mxGeometry x="612" y="235" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_guard" value="&lt;b&gt;★ THE GUARD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reads every question before it goes anywhere.&lt;br&gt;Reads every answer before you see it.&lt;br&gt;&lt;font color=&quot;#9A3412&quot; style=&quot;font-size:10px;&quot;&gt;mediation layer · CONTROL 2&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D97706;strokeWidth=3;fontSize=12;fontColor=#7C2D12;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="735" y="230" width="220" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n_tools" value="&lt;b&gt;The toy box&lt;/b&gt;&lt;br&gt;The AI may only play with toys on the list — and somebody else hands them over, so the AI never holds the keys itself.&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;tool / MCP executor · scoped, short-lived credentials&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="612" y="420" width="343" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_nonat" value="&lt;b&gt;No back door.&lt;/b&gt; There is no road from this room to the open internet — no NAT gateway — so there is nowhere to sneak anything out to." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;dashed=1;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="612" y="550" width="343" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n_vpce" value="&lt;b&gt;Secret corridor&lt;/b&gt;&lt;br&gt;the only path to the helper and the files — never over the internet&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;VPC endpoints · PrivateLink&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.endpoints;" vertex="1" parent="1">
          <mxGeometry x="1011" y="290" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="n_bedrock" value="&lt;b&gt;The clever helper&lt;/b&gt;&lt;br&gt;answers the question. Has its own rules that nobody can talk it out of&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;Amazon Bedrock + guardrail, pinned version&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="1151" y="215" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_aoss" value="&lt;b&gt;The card index&lt;/b&gt;&lt;br&gt;finds the right pages fast. Cannot be reached from the internet at all&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;OpenSearch Serverless · AllowFromPublic = false&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticsearch_service;" vertex="1" parent="1">
          <mxGeometry x="1151" y="385" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_s3" value="&lt;b&gt;The filing cabinet&lt;/b&gt;&lt;br&gt;the real company documents&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;S3 · versioned, our own KMS key&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="1151" y="535" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="n_cw" value="&lt;b&gt;The diary&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;CloudWatch&lt;/font&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="110" y="790" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n_siem" value="&lt;b&gt;The grown-ups&lt;/b&gt;&lt;br&gt;get told when something is refused&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;SIEM · detections and alerting&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="285" y="785" width="195" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_opsnote" value="&lt;b&gt;Why this row exists:&lt;/b&gt; a refusal is not the end of the story. Every decision — who asked, which door stopped it, and why — is written down, and a human sees the pattern. A control nobody can look at afterwards is a promise, not a control.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#7D8998&quot; style=&quot;font-size:10px;&quot;&gt;events: ai.prompt_injection.blocked · ai.tool.denied · ai.request.completed&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;fontSize=12;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="780" width="930" height="110" as="geometry" />
        </mxCell>

        <mxCell id="foot1" value="Grey small text = the real AWS service name.  Every box on this page exists as Terraform in controls/terraform/ — the picture and the code cannot drift apart." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#7D8998;" vertex="1" parent="1">
          <mxGeometry x="40" y="945" width="1300" height="25" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="1  log in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#232F3E;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_user" target="n_idp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2  badge says who you are&#xa;and which teams you are in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#232F3E;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_idp" target="n_apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=2;strokeColor=#232F3E;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_waf" target="n_apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="3  the only door in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=3;strokeColor=#D97706;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_apigw" target="n_guard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="4  out through the&#xa;secret corridor only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=3;strokeColor=#D97706;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_guard" target="n_vpce">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="5  bring back only the pages&#xa;your teams are allowed to read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#232F3E;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_vpce" target="n_aoss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="6  ask the helper&#xa;guardrail attached" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#232F3E;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_vpce" target="n_bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="the pages live here" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=2;strokeColor=#7D8998;dashed=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_aoss" target="n_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="7  use a tool — only if it is on the list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#232F3E;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_guard" target="n_tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="everything in here is written down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=2;strokeColor=#E7157B;dashed=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="n_cw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="705" />
              <mxPoint x="149" y="705" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeWidth=2;strokeColor=#E7157B;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="n_cw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1285" y="705" />
              <mxPoint x="149" y="705" />
            </Array>
          </mxGeometry>
